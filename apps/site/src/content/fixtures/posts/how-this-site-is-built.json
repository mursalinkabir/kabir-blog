                "version": 1,
                "children": [
                  {
                    "detail": 0,
                    "format": 1,
                    "mode": "normal",
                    "style": "",
                    "text": "Cost: ",
                    "type": "text",
                    "version": 1
                  },
                  {
                    "detail": 0,
                    "format": 0,
                    "mode": "normal",
                    "style": "",
                    "text": "no application runtime on the read path.",
                    "type": "text",
                    "version": 1
                  }
                ],
                "type": "listitem",
                "value": 2
              },
              {
                "direction": "ltr",
                "format": "",
                "indent": 0,
                "version": 1,
                "children": [
                  {
                    "detail": 0,
                    "format": 1,
                    "mode": "normal",
                    "style": "",
                    "text": "Security: ",
                    "type": "text",
                    "version": 1
                  },
                  {
                    "detail": 0,
                    "format": 0,
                    "mode": "normal",
                    "style": "",
                    "text": "the CMS is only reachable behind an access gate.",
                    "type": "text",
                    "version": 1
                  }
                ],
                "type": "listitem",
                "value": 3
              }
            ],
            "listType": "bullet",
            "start": 1,
