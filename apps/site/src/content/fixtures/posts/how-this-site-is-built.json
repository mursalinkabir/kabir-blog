              {
                "detail": 0,
                "format": 0,
                "mode": "normal",
                "style": "",
                "text": "Why not just render pages from the CMS?",
                "type": "text",
                "version": 1
              }
            ],
            "type": "heading",
            "tag": "h2"
          },
          {
            "direction": "ltr",
            "format": "",
