                  {
                    "detail": 0,
                    "format": 1,
                    "mode": "normal",
                    "style": "",
                    "text": "Availability: ",
                    "type": "text",
                    "version": 1
                  },
                  {
                    "detail": 0,
                    "format": 0,
                    "mode": "normal",
                    "style": "",
                    "text": "a static file keeps working when the database does not.",
                    "type": "text",
                    "version": 1
                  }
