                  }
                ]
              },
              {
                "detail": 0,
                "format": 0,
                "mode": "normal",
                "style": "",
                "text": ". All from Wikimedia Commons, resized and converted to WebP.",
                "type": "text",
                "version": 1
              }
            ]
