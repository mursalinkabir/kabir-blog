                    "text": "CC0",
                    "type": "text",
                    "version": 1
                  }
                ]
              },
              {
                "detail": 0,
                "format": 0,
                "mode": "normal",
                "style": "",
                "text": "; ",
                "type": "text",
                "version": 1
              },
              {
                "direction": "ltr",
                "format": "",
                "indent": 0,
                "version": 3,
                "type": "link",
                "fields": {
                  "linkType": "custom",
                  "newTab": true,
                  "url": "https://commons.wikimedia.org/wiki/File:%E7%89%87%E5%80%89%E5%9F%8E%E5%9D%80%E5%85%AC%E5%9C%92%E7%A9%BA%E5%A0%80.jpg"
                },
                "children": [
                  {
                    "detail": 0,
                    "format": 0,
                    "mode": "normal",
                    "style": "",
                    "text": "Katakura Castle moat",
                    "type": "text",
                    "version": 1
                  }
                ]
              },
              {
                "detail": 0,
                "format": 0,
                "mode": "normal",
                "style": "",
                "text": " by Takaosan fukujuso, ",
                "type": "text",
                "version": 1
              },
              {
                "direction": "ltr",
                "format": "",
                "indent": 0,
                "version": 3,
                "type": "link",
                "fields": {
                  "linkType": "custom",
                  "newTab": true,
