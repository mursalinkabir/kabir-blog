                "format": "",
                "type": "inlineBlock",
                "version": 1
              },
              {
                "detail": 0,
                "format": 0,
                "mode": "normal",
                "style": "",
                "text": ", and it is one of the first things to hide in a photo.",
                "type": "text",
                "version": 1
              }
            ],
            "type": "paragraph"
