;\n      var v = text(\"0\", BX + BW + 20, y + 6, { size: 21, tnum: true, parent: bg2 });\n      return { g: bg2, fill: f, val: v, target: r[1] };\n    });\n    text(\"0\", BX, 620, { size: 17, fill: C.muted, parent: g });\n    text(\"100\", BX + BW, 620, { size: 17, fill: C.muted, anchor: \"end\", parent: g });\n\n    var cap = text(\"Read from the filing itself. A number it doesn't report is left out, never shown as zero.\",\n      200, 820, { size: 24, fill: C.muted });\n    g.appendChild(cap);\n\n    return {\n      g: g,\n      update: function (t) {\n        var inP = eo(seg(t, 21050, 21600));\n        var collapse = eo(seg(t, 21650, 22150));\n        fade(doc, inP * (1 - collapse));\n        doc.setAttribute(\"transform\",\n          \"translate(\" + (-220 * (1 - inP)) + \",0) translate(330,430) scale(\" + (1 - 0.55 * collapse) + \") translate(-330,-430)\");\n\n        var sp = eo(seg(t, 22100, 23000));\n        score.textContent = Math.round(78 * sp);\n        fade(score, seg(t, 22100, 22300));\n        fade(of, seg(t, 22600, 22900));\n        fade(verdict, eo(seg(t, 22900, 23250)));\n\n        bars.forEach(function (b, i) {\n          var a = 22950 + i * 120;\n          var p = eo(seg(t, a, a + 520));\n          fade(b.g, seg(t, a - 150, a + 50));\n          b.fill.setAttribute(\"width\", BW * (b.target / 100) * p);\n          b.val.textContent = Math.round(b.target * p);\n        });\n        fade(cap, eo(seg(t, 23400, 23800)));\n      }\n    };\n  }\n\n  // ---- scene 6: value against cost --------------------------------------\n  function buildPortfolio() {\n    var g = el(\"g\", {});\n    var VAL = [10000,10420,10180,10910,11240,15180,15640,15020,15880,16210,15940,16480];\n    var COST = [10000,10000,10000,10000,10000,14000,14000,14000,14000,14000,14000,14000];\n    var X0 = 240, X1 = 1360, VLO = 9000, VHI = 17500, Y0 = 280, Y1 = 660;\n    var x = function (i) { return X0 + i * (X1 - X0) / (VAL.length - 1); };\n    var y = function (v) { return Y1 - (v - VLO) * (Y1 - Y0) / (VHI - VLO); };\n\n    [10000, 12500, 15000, 17500].forEach(function (v) {\n      el(\"line\", { x1: X0, y1: y(v), x2: X1, y2: y(v), stroke: C.line, \"stroke-width\": 1 }, g);\n      text(\"$\" + v.toLocaleString(\"en-US\"), X1 + 18, y(v) + 6, { size: 18, fill: C.muted, tnum: true, parent: g });\n    });\n\n    // cost is a step, not a ramp: it holds flat, then jumps the day money lands\n    var costPts = [];\n    COST.forEach(function (v, i) {\n      if (i > 0 && v !== COST[i - 1]) { costPts.push(x(i) + \",\" + y(COST[i - 1])); }\n      costPts.push(x(i) + \",\" + y(v));\n    });\n    var costLine = el(\"polyline\", {\n      points: costPts.join(\" \"),\n      fill: \"none\", stroke: C.muted, \"stroke-width\": 3\n    }, g);\n    var valLine = el(\"polyline\", {\n      points: VAL.map(function (v, i) { return x(i) + \",\" + y(v); }).join(\" \"),\n      fill: \"none\", stroke: C.up, \"stroke-width\": 4\n    }, g);\n    var endDot = el(\"circle\", { cx: x(11), cy: y(VAL[11]), r: 8, fill: C.up }, g);\n\n    var marker = el(\"g\", {}, g);\n    el(\"line\", { x1: x(5), y1: 250, x2: x(5), y2: Y1, stroke: C.line, \"stroke-width\": 2 }, marker);\n    text(\"You add $4,000 here\", x(5) + 18, 290, { size: 24, parent: marker });\n    text(\"the cost line steps up with it\", x(5) + 18, 322, { size: 20, fill: C.muted, parent: marker });\n\n    var lv = text(\"Value 16,480\", 240, 208, { size: 22, fill: C.up, tnum: true });\n    var lc = text(\"Cost 14,000\", 450, 208, { size: 22, fill: C.muted, tnum: true });\n    g.appendChild(lv); g.appendChild(lc);\n\n    var cap = text(\"So a deposit can never look like a return.\", 240, 820, { size: 24, fill: C.muted });\n    g.appendChild(cap);\n\n    return {\n      g: g,\n      update: function (t) {\n        var p = eo(seg(t, 25100, 26400));\n        dash(valLine, p);\n        dash(costLine, eo(seg(t, 25250, 26500)));\n        fade(endDot, seg(t, 26350, 26600));\n        fade(marker, eo(seg(t, 26450, 26900)));\n    