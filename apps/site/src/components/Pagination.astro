---
import { t, formatNumber, type Locale } from '~/i18n';

interface Props {
  locale: Locale;
  current: number;
  total: number;
  hrefFor: (n: number) => string;
}
const { locale, current, total, hrefFor } = Astro.props;

// 1 … (current-1) current (current+1) … total
const pages: (number | 'gap')[] = [];
for (let n = 1; n <= total; n++) {
  if (n === 1 || n === total || Math.abs(n - current) <= 1) pages.push(n);
  else if (pages[pages.length - 1] !== 'gap') pages.push('gap');
}
---

{
  total > 1 && (
    <nav class="pagination" aria-label={t(locale, 'a11y.pagination')}>
      <ul role="list">
        <li>
          {current > 1 ? (
            <a class="page-link" href={hrefFor(current - 1)} rel="prev" aria-label={t(locale, 'pagination.previous')}>
              ‹
            </a>
          ) : (
            <span class="page-link is-disabled" aria-hidden="true">
              ‹
            </span>
          )}
        </li>
        {pages.map((n) =>
          n === 'gap' ? (
            <li aria-hidden="true">
              <span class="page-gap">…</span>
            </li>
          ) : (
            <li>
              <a
                class:list={['page-link', { 'is-current': n === current }]}
                href={hrefFor(n)}
                aria-label={t(locale, 'pagination.page', { n: formatNumber(locale, n) })}
                aria-current={n === current ? 'page' : undefined}
              >
                {formatNumber(locale, n)}
              </a>
            </li>
          ),
        )}
        <li>
          {current < total ? (
            <a class="page-link" href={hrefFor(current + 1)} rel="next" aria-label={t(locale, 'pagination.next')}>
              ›
            </a>
          ) : (
            <span class="page-link is-disabled" aria-hidden="true">
              ›
            </span>
          )}
        </li>
      </ul>
    </nav>
  )
}
