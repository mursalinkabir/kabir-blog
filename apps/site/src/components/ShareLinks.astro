---
import SocialIcon from './SocialIcon.astro';
import { t, type Locale } from '~/i18n';
import { absolute } from '~/lib/routes';

interface Props {
  locale: Locale;
  title: string;
  path: string;
}
const { locale, title, path } = Astro.props;
const url = absolute(path);
const enc = encodeURIComponent;
const targets = [
  { key: 'x', icon: 'x', label: t(locale, 'share.x'), href: `https://x.com/intent/post?text=${enc(title)}&url=${enc(url)}` },
  {
    key: 'linkedin',
    icon: 'linkedin',
    label: t(locale, 'share.linkedin'),
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${enc(url)}`,
  },
  {
    key: 'facebook',
    icon: 'facebook',
    label: t(locale, 'share.facebook'),
    href: `https://www.facebook.com/sharer/sharer.php?u=${enc(url)}`,
  },
  {
    key: 'hatena',
    icon: 'bookmark',
    label: t(locale, 'share.hatena'),
    href: `https://b.hatena.ne.jp/entry/s/${url.replace(/^https:\/\//, '')}`,
  },
];
---

<div class="share">
  <span class="share-title">{t(locale, 'share.title')}</span>
  <ul role="list" aria-label={t(locale, 'a11y.share')}>
    {
      targets.map((s) => (
        <li>
          <a class="icon-btn" href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label}>
            <SocialIcon name={s.icon} />
          </a>
        </li>
      ))
    }
    <li>
      <button
        type="button"
        class="icon-btn"
        data-copy-link={url}
        data-copied={t(locale, 'share.copied')}
        data-failed={t(locale, 'share.copyFailed')}
        hidden
        aria-label={t(locale, 'share.copy')}
      >
        <svg
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          focusable="false"
          ><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1"></path><path d="M14 10a4 4 0 0 0-5.7 0l-3 3A4 4 0 0 0 11 18.7l1-1"
          ></path></svg
        >
      </button>
    </li>
  </ul>
  <span class="visually-hidden" role="status" data-copy-status></span>
</div>

<script>
  import '~/scripts/copy-link';
</script>
