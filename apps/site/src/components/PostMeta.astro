---
import Avatar from './Avatar.astro';
import CategoryIcon from './CategoryIcon.astro';
import { localePath, formatDate, formatNumber, t, type Locale } from '~/i18n';
import { categoryRoute, siteName, type PostView } from '~/lib/cms';

interface Props {
  post: PostView;
  locale: Locale;
  /** Add reading time (article pages). */
  readingTime?: boolean;
  /** The cover link already hides from assistive tech; the meta row is plain text plus the category link. */
}
const { post, locale, readingTime = false } = Astro.props;
---

<ul class="meta" role="list">
  <li class="meta-author"><Avatar locale={locale} />{siteName(locale)}</li>
  <li>
    <svg
      viewBox="0 0 24 24"
      width="16"
      height="16"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"><rect x="3.5" y="5" width="17" height="15.5" rx="2.5"></rect><path d="M8 3v4M16 3v4M3.5 10h17"></path></svg
    >
    <time datetime={post.pubDate}>{formatDate(locale, post.pubDate, { month: locale === 'ja' ? 'long' : 'short' })}</time>
  </li>
  <li>
    <a href={localePath(locale, `/${categoryRoute[post.category.slug]}/`)}
      ><CategoryIcon category={post.category.slug} size={16} />{post.category.name}</a
    >
  </li>
  {readingTime && <li>{t(locale, 'posts.readingTime', { n: formatNumber(locale, post.readingMinutes) })}</li>}
</ul>
