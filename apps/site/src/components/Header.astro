---
import { t, localePath, locales, htmlLang, type Locale, type StringKey } from '~/i18n';
import { getSite, navPageExists, siteName } from '~/lib/cms';
import { initials, type Alternates } from '~/lib/routes';

interface Props {
  locale: Locale;
  path: string;
  alternates: Alternates;
}
const { locale, path, alternates } = Astro.props;

const navPaths: Record<string, string> = {
  home: '/',
  tech: '/tech/',
  finance: '/finance/',
  japan: '/japan/',
  about: '/about/',
  contact: '/contact/',
  projects: '/projects/',
  resume: '/resume/',
  now: '/now/',
  uses: '/uses/',
  categories: '/categories/',
  tags: '/tags/',
};
const site = getSite();
// A section is listed only where its page exists in this locale (resume: English only; Uses/Now/About when written).
const visible = (keys: string[]) => keys.filter((k) => navPaths[k] && navPageExists(k, locale));
const primary = visible(site.nav);
const more = visible(site.navMore);
const home = localePath(locale, '/');
const hrefOf = (key: string) => localePath(locale, navPaths[key]!);
const isCurrent = (key: string) => {
  const href = hrefOf(key);
  if (key === 'home') return path === home || path.startsWith(`${home}page/`);
  return path === href || path.startsWith(href);
};
const moreActive = more.some(isCurrent);
const label = (key: string) => t(locale, `nav.${key}` as StringKey);
const short: Record<Locale, string> = { en: 'EN', ja: '日本語' };
---

<header class="site-header">
  <div class="container header-row">
    <a class="logo" href={home}>
      <span class="logo-mark" aria-hidden="true">{initials(siteName('en'))}</span>
      <span class="logo-text">{siteName(locale)}</span>
    </a>

    <nav class="nav-desktop" aria-label={t(locale, 'a11y.mainNav')}>
      <ul role="list">
        {
          primary.map((key) => (
            <li>
              <a href={hrefOf(key)} aria-current={isCurrent(key) ? 'page' : undefined}>
                {label(key)}
              </a>
            </li>
          ))
        }
        {
          more.length > 0 && (
            <li>
              <details class:list={['more', { 'is-active': moreActive }]}>
                <summary>
                  {t(locale, 'nav.more')}
                  <svg
                    viewBox="0 0 24 24"
                    width="14"
                    height="14"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.4"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <path d="m6 9 6 6 6-6" />
                  </svg>
                </summary>
                <ul role="list">
                  {more.map((key) => (
                    <li>
                      <a href={hrefOf(key)} aria-current={isCurrent(key) ? 'page' : undefined}>
                        {label(key)}
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            </li>
          )
        }
      </ul>
    </nav>

    <div class="header-tools">
      <ul class="lang-switch" role="list" aria-label={t(locale, 'a11y.language')}>
        {
          locales.map((l) =>
            l === locale ? (
              <li>
                <span class="lang-current" lang={htmlLang[l]} aria-current="true">
                  {short[l]}
                  <span class="visually-hidden"> {t(l, `lang.${l}`)}</span>
                </span>
              </li>
            ) : alternates[l] ? (
              <li>
                <a href={alternates[l]} hreflang={htmlLang[l]} lang={htmlLang[l]}>
                  {short[l]}
                  <span class="visually-hidden"> {t(l, `lang.${l}`)}</span>
                </a>
              </li>
            ) : null,
          )
        }
      </ul>
      <a class="icon-btn" href={localePath(locale, '/search/')} aria-label={t(locale, 'nav.search')}>
        <svg
          viewBox="0 0 24 24"
          width="20"
          height="20"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
          focusable="false"><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="m15.5 15.5 5 5"></path></svg
        >
      </a>
      <details class="menu">
        <summary class="icon-btn" aria-label={t(locale, 'a11y.menu')}>
          <svg
            viewBox="0 0 24 24"
            width="22"
            height="22"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
            focusable="false"><path d="M4 7h16M4 12h16M4 17h16"></path></svg
          >
        </summary>
        <nav class="nav-mobile" aria-label={t(locale, 'a11y.mainNav')}>
          <ul role="list">
            {
              [...primary, ...more].map((key) => (
                <li>
                  <a href={hrefOf(key)} aria-current={isCurrent(key) ? 'page' : undefined}>
                    {label(key)}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  import '~/scripts/menu';
</script>
