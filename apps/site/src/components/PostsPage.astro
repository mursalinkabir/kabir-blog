---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PostCard from './PostCard.astro';
import Pagination from './Pagination.astro';
import CategoryIcon from './CategoryIcon.astro';
import { t, localePath, type Locale } from '~/i18n';
import type { PostView } from '~/lib/cms';
import { siteName, getSite, pick, categoryRoute } from '~/lib/cms';
import { pageCount, pageItems, pagePath } from '~/lib/paginate';
import type { Alternates } from '~/lib/routes';

interface Props {
  locale: Locale;
  posts: PostView[];
  page: number;
  /** Path of page 1, e.g. "/" or "/tech/". */
  base: string;
  /** Visible heading with the teal bar. Omit on home, which gets a visually hidden h1. */
  title?: string;
  description?: string;
  /** Alternates for page 1. */
  alternates?: Alternates;
  rss?: { href: string; title: string }[];
  structuredData?: object[];
  /** Larger first card on page 1. */
  featured?: boolean;
}
const { locale, posts, page, base, title, description, alternates = {}, rss = [], structuredData = [], featured = true } = Astro.props;
const total = pageCount(posts.length, featured);
const items = pageItems(posts, page, featured);
const showFeatured = featured && page === 1 && items.length > 0;
const path = pagePath(locale, base, page);
const pageLabel = page > 1 ? ` (${t(locale, 'pagination.page', { n: page })})` : '';
const heading = title ?? siteName(locale);
// The home page opens with a hero: the site name as the page's one h1, the tagline, and a chip per topic.
const hero = !title && page === 1;
const tagline = pick(getSite().tagline, locale);
const topics = [...new Map(posts.map((p) => [p.category.slug, p.category])).values()].map((c) => ({
  ...c,
  count: posts.filter((p) => p.category.slug === c.slug).length,
}));
// Home page 1 is titled with the site name alone; later pages get "Page n" (the layout appends the site name).
const metaTitle = title ? `${title}${pageLabel}` : page > 1 ? t(locale, 'pagination.page', { n: page }) : heading;
---

<BaseLayout
  title={metaTitle}
  description={description ?? t(locale, 'posts.description')}
  locale={locale}
  path={path}
  alternates={page === 1 ? alternates : { [locale]: path }}
  noindex={items.length === 0}
  rss={rss}
  structuredData={structuredData}
>
  <div class="container listing">
    {
      title ? (
        <header class="page-head">
          <h1 class="page-title">{title}</h1>
          {description && <p class="page-lede">{description}</p>}
        </header>
      ) : hero ? (
        <header class="hero">
          <p class="hero-eyebrow">{topics.map((c) => c.name).join(' · ') || t(locale, 'posts.description')}</p>
          <h1 class="hero-title">{heading}</h1>
          {tagline && <p class="hero-lead">{tagline}</p>}
          {topics.length > 1 && (
            <ul class="hero-topics" role="list">
              {topics.map((c) => (
                <li>
                  <a class="topic-chip" data-topic={c.slug} href={localePath(locale, `/${categoryRoute[c.slug]}/`)}>
                    <CategoryIcon category={c.slug} size={18} />
                    {c.name}
                    <span class="topic-chip-count">{c.count}</span>
                  </a>
                </li>
              ))}
            </ul>
          )}
        </header>
      ) : (
        <h1 class="visually-hidden">{heading}</h1>
      )
    }
    {
      items.length === 0 ? (
        <div class="empty">
          <p>{t(locale, locale === 'en' ? 'posts.noPosts' : 'posts.noPostsLocale')}</p>
          {locale !== 'en' && (
            <p>
              <a class="btn" href={alternates.en ?? '/'} lang="en">
                {t('en', 'posts.readEnglish')}
              </a>
            </p>
          )}
        </div>
      ) : (
        <div class:list={['bento', { 'has-feature': showFeatured, 'is-few': showFeatured && items.length < 5 }]}>
          {items.map((post, i) => (
            <PostCard post={post} locale={locale} featured={showFeatured && i === 0} eager={i < (showFeatured ? 1 : 2)} />
          ))}
        </div>
      )
    }
    <Pagination locale={locale} current={page} total={total} hrefFor={(n) => pagePath(locale, base, n)} />
  </div>
</BaseLayout>
