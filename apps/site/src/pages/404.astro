---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { t } from '~/i18n';
---

<BaseLayout title={t('en', 'notFound.title')} description={t('en', 'notFound.body')} locale="en" path="/404.html" noindex>
  <div class="page">
    <div class="prose-width">
      <header class="page-head">
        <h1 class="page-title">{t('en', 'notFound.title')}</h1>
        <p class="page-lede">{t('en', 'notFound.body')}</p>
      </header>
      <p class="actions">
        <a class="btn" href="/">{t('en', 'notFound.home')}</a>
        <a class="btn btn-ghost" href="/ja/" lang="ja">{t('ja', 'notFound.home')}</a>
      </p>
    </div>
  </div>
</BaseLayout>
