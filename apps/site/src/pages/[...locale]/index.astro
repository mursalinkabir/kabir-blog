---
import PostsPage from '~/components/PostsPage.astro';
import { siteName, getPosts, getSite, pick } from '~/lib/cms';
import { absolute, bothLocales, perLocale } from '~/lib/routes';
import { t, type Locale } from '~/i18n';

export const getStaticPaths = () => perLocale(() => [{}]);
const { locale } = Astro.props as { locale: Locale };
const posts = getPosts(locale);
---

<PostsPage
  locale={locale}
  posts={posts}
  page={1}
  base="/"
  description={pick(getSite().tagline, locale) ?? t(locale, 'posts.description')}
  alternates={bothLocales('/')}
  rss={[{ href: locale === 'en' ? '/rss.xml' : '/ja/rss.xml', title: siteName(locale) }]}
  structuredData={[
    { '@context': 'https://schema.org', '@type': 'WebSite', name: siteName(locale), url: absolute('/'), inLanguage: locale },
  ]}
/>
