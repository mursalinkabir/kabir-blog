# Only PUBLIC_* values in a .env file reach the site code (Vite's import.meta.env).
# Cloudflare Turnstile site key (public). Without it the contact form renders disabled. Phase 8.
PUBLIC_TURNSTILE_SITEKEY=

# The two below are read from the process environment, NOT from .env: export them in the shell or set them in CI.
#   BUILD_ID=<sha>-<run_id>   version.json reports it; the verify step compares against it. Required when CI is set.
#   SITE_TYPOGRAPHY_TEST=1    also builds /ja/typography-test/ (Phase 1 gate page); check-dist then allows it.
#   SITE_PAGE_SIZE=2          cards per page; use it to exercise pagination with few posts.
