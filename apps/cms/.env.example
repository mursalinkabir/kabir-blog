# Copy to .env (git-ignored). Values here are for LOCAL development only.
DATABASE_URL=postgres://payload:payload-dev-only@127.0.0.1:5433/payload
# Any long random string. Generate: openssl rand -hex 32
PAYLOAD_SECRET=
# Used by the admin and by the site's pull script when reading content.
CMS_PUBLIC_URL=http://localhost:3100

# Media storage. Unset = files on local disk (apps/cms/media). Set all four for R2 (Phase 4):
# S3_BUCKET=kabir-blog-media
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Public base URL the site uses for media (a custom domain on the bucket):
# MEDIA_PUBLIC_URL=https://media.smkabir.com

# --- AI agent (MCP) publishing: docs/agents.md ---------------------------------------------------------------------
# The kill switch. Anything but exactly 1 means an agent can write drafts but cannot publish.
AGENT_AUTO_PUBLISH=0
# Publishes per rolling 24 hours (a post in two languages is two). Default 6.
# AGENT_MAX_PUBLISHES_PER_DAY=6
# Shortest acceptable body in characters, both languages. Default: 600 English, 300 Japanese.
# AGENT_MIN_CHARS=
# Hosts the upload_image tool may fetch from (https only, no redirects). Default images.unsplash.com.
# AGENT_IMAGE_HOSTS=images.unsplash.com
# Private words that must never be published (the same list the CI privacy scan uses). Comma separated.
# PRIVACY_DENYLIST=
# Rebuild the site when content is published. Fine-grained token, THIS repository only, "Contents: Read and write".
# Unset locally: publishing then logs that no rebuild was requested.
# GITHUB_DISPATCH_TOKEN=
# GITHUB_REPOSITORY=mursalinkabir/kabir-blog
