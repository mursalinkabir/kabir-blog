# Copy to .env (git-ignored). Values here are for LOCAL development only.
DATABASE_URL=postgres://payload:payload-dev-only@127.0.0.1:5433/payload
# Any long random string. Generate: openssl rand -hex 32
PAYLOAD_SECRET=
# Used by the admin and by the site's pull script when reading content.
CMS_PUBLIC_URL=http://localhost:3100

# Media storage. Unset = files on local disk (apps/cms/media). Set all four for R2 (Phase 4):
# S3_BUCKET=smkabir-media
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Public base URL the site uses for media (a custom domain on the bucket):
# MEDIA_PUBLIC_URL=https://media.smkabir.com
